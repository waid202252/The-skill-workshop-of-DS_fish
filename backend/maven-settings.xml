<?xml version="1.0" encoding="UTF-8"?>
<!--
  本项目专用 Maven 配置。
  原因：全局 conf/settings.xml 把 localRepository 指向 D:\Program Files\repository，
  该目录当前账号不可写，会导致依赖解析失败。这里把仓库放到工作区内。
  用法：mvn -s maven-settings.xml ...
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <localRepository>D:\develop\2025_6\.m2repo</localRepository>

    <mirrors>
        <mirror>
            <id>aliyun-public</id>
            <mirrorOf>central</mirrorOf>
            <name>Aliyun Maven Public</name>
            <url>https://maven.aliyun.com/repository/public</url>
        </mirror>
    </mirrors>
</settings>
