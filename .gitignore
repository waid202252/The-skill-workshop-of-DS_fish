# 构建产物
backend/target/
frontend/dist/
frontend/node_modules/

# 本地 Maven 仓库（本机专用缓存，150MB+，不要提交）
.m2repo/

# 运行时数据
# 前置斜杠 = 只匹配仓库根目录：防止误伤 frontend/src/data 这类业务目录
/data/
backend/data/
backend/uploads/
*.log

# IDE
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# 本地环境变量
.env
.env.local
# 部署密钥（只提交 .env.example）
deploy/.env

# 启动时用的临时目录
.tmp/

# 运行时产物（每次启动写入的访问地址，与机器相关，不入库）
runtime/

# 备份产物（含完整数据库导出，绝不能入库）
backups/
