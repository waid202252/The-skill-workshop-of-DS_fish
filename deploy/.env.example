# 复制成 .env 后修改。.env 已被 .gitignore 排除，不要提交。
#   cp .env.example .env

# MySQL root 密码（compose 内的 mysql 容器使用）
MYSQL_ROOT_PASSWORD=change-me-please
MYSQL_DB=weliao

# JWT 签名密钥：至少 32 字节，生产必须替换
# 生成方式：openssl rand -base64 48
IM_JWT_SECRET=please-change-this-to-a-random-32-bytes-or-longer-secret

# 对外访问端口（浏览器访问 http://localhost:<WEB_PORT>）
WEB_PORT=8080

# ---- AI 伙伴（可选，留空则使用本地模拟回复）----
# 免费云端：智谱 GLM-4-Flash（国内直连，OpenAI 兼容）
#   AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   AI_MODEL=glm-4-flash
# 本地 Ollama（备选）：
#   AI_BASE_URL=http://host.docker.internal:11434/v1
#   AI_MODEL=qwen2.5:3b
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=120

# ---- GitHub（技能市场数据源，可选但强烈建议）----
# 不配置也能用，但配额只有 search 10 次/分钟、core 60 次/小时，很容易被限流。
# 配了之后是 30 次/分钟、5000 次/小时。
# 生成方式：GitHub → Settings → Developer settings → Personal access tokens
#           勾选 public_repo 即可（只读公开仓库，不需要额外权限）
GITHUB_TOKEN=

# ---- 数据库网页控制台 Adminer（可选）----
# 只绑定 127.0.0.1，改端口冲突时用
ADMINER_PORT=8082

# ---- 跨节点推送（在线状态 / 多实例投递）----
# auto ：连得上 redis 容器就启用跨节点，连不上自动退回单机内存（默认，推荐）
# local：强制单机，完全不碰 Redis（只有一个后端实例时最省事）
# redis：强制 Redis，连不上直接启动失败（生产推荐，把配置错误暴露在部署阶段）
CLUSTER_MODE=auto
# 节点标识。留空 = 自动用「主机名-随机串」，--scale 起多副本不会撞车。
# 想从日志和 Redis 里一眼认出是哪台实例，就显式写：CLUSTER_NODE_ID=ws-1
CLUSTER_NODE_ID=
